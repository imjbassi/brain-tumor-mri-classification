__pycache__/
*.pyc
*.aux
*.log
*.out

# Third-party image data and every split derived from it. These are not ours
# to redistribute; the scripts rebuild them from a local copy of the sources.
data/
data_dedup/
data_dedup_near/
data_patient/
data_cv_fold*/
external/

# Model weights: ~45 MB each, ~2.7 GB in total. Not archived.
checkpoints/
*.pth

# Run artifacts. Checkpoints and figures are excluded, but the per-image
# predictions and per-run metrics ARE released: they are what the paper's
# main result is computed from, and analyze_cv.py consumes them directly,
# so the paired comparison and variance decomposition can be re-derived
# without retraining anything. Total ~4 MB.
runs/**
!runs/**/
!runs/**/predictions.csv
!runs/**/history.json
!runs/**/results.json

# Regenerated by build_cv_folds.py; derivable, and large.
group_map.json
